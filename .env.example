# Platform secrets ONLY. Per-client values (business name, staff numbers, payment keys, WhatsApp instance) live in the database.
APP_ENV=production
PUBLIC_BASE_URL=https://api.your-domain.com

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
GROQ_API_KEY=                 # optional: fallback LLM + voice-note transcription

PLATFORM_ADMIN_KEY=           # openssl rand -urlsafe 32  (creates tenants + channels)
INTERNAL_CRON_SECRET=         # protects POST /internal/tick
VAULT_MASTER_KEY=             # python -c "from hooze.security import Vault; print(Vault.generate_key())"  (encrypts tenant credentials; LOSING IT LOSES THEM)

# Required once you run more than one worker (locks + cache are per-process without it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NUDGES_GLOBALLY_ENABLED=true  # global kill switch for follow-ups

# ── Alerts: how you find out something is broken (set at least one, then Dashboard → Overview → "Send test alert") ──
# WhatsApp: YOUR phone number(s), comma separated. Any normal way of writing it works: 08012345678, +234 801 234 5678 or 2348012345678
# (all become 2348012345678). Alerts are sent from a CONNECTED WhatsApp number of yours; leave ALERT_CHANNEL_ID empty unless you want to
# force a specific one (best practice: a dedicated ops number so a client's own number never carries your alerts).
ALERT_WHATSAPP_NUMBERS=
ALERT_CHANNEL_ID=
# Email via Resend (the key is required for email to count as configured)
ALERT_EMAIL_TO=
RESEND_API_KEY=
ALERT_EMAIL_FROM=Hooze Alerts <alerts@hoozeenterprises.com>
ALERT_DEDUPE_MINUTES=30

# ── Durable inbound queue (defaults are sensible; change only with a reason) ──
INBOUND_MAX_ATTEMPTS=5
INBOUND_LEASE_SECONDS=180
INBOUND_RECOVERY_INTERVAL_SECONDS=30
INBOUND_MAX_CONCURRENCY=10
MAINTENANCE_ENABLED=true

# ── Dashboard (the browser app) must be allowed to call the API ──
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# ── Speed: a failing AI provider should cost one short wait per few minutes, not 20s on every message ──
LLM_TIMEOUT_SECONDS=8
LLM_PROVIDER_COOLDOWN_SECONDS=300

# --- Menu photos & videos (optional; these are the defaults) ---
# Uploads go to a PUBLIC Supabase Storage bucket (created automatically on the first upload) so WhatsApp can fetch them by link.
# MEDIA_BUCKET=media
# MEDIA_MAX_IMAGE_MB=15
# MEDIA_MAX_VIDEO_MB=16
# MEDIA_IMAGE_MAX_PX=1600


# Legacy: accept the webhook secret as ?token= in the URL (it ends up in access logs). Leave false unless a hand-set number needs it.
WEBHOOK_ALLOW_QUERY_TOKEN=false
